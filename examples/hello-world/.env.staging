# Load these variables explicitly through your staging deployment configuration.

# App
APP_ENV=staging
NEXT_PUBLIC_APP_NAME="Hello World"
NEXT_PUBLIC_APP_URL=https://staging.example.com

# PlanetScale · MySQL
# Use separate credentials for the staging branch.
DATABASE_URL="mysql://hello_world_staging:example_staging_password@aws.connect.psdb.cloud/hello-world?sslaccept=strict"

# Better Auth · Sessions
BETTER_AUTH_URL=https://staging.example.com
BETTER_AUTH_SECRET=example_staging_better_auth_secret_replace_me

# Resend · Transactional email
RESEND_API_KEY=re_example_staging_replace_me
RESEND_FROM_EMAIL="Hello World <hello@staging.example.com>"

# Stripe · Test payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example_staging_replace_me
STRIPE_SECRET_KEY=sk_test_example_staging_replace_me
# Use the signing secret for the staging webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_example_staging_replace_me
STRIPE_PRICE_ID=price_example_staging_monthly
