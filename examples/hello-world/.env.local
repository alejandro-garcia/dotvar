# App
APP_ENV=local
NEXT_PUBLIC_APP_NAME="Hello World"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PlanetScale · MySQL
# Use a development branch for local work.
DATABASE_URL="mysql://hello_world_dev:example_local_password@aws.connect.psdb.cloud/hello-world?sslaccept=strict"

# Better Auth · Sessions
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=example_local_better_auth_secret_replace_me

# Resend · Transactional email
RESEND_API_KEY=re_example_local_replace_me
RESEND_FROM_EMAIL="Hello World <hello@local.example.com>"

# Stripe · Test payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example_local_replace_me
STRIPE_SECRET_KEY=sk_test_example_local_replace_me
# Use the signing secret from Stripe CLI when forwarding events locally.
STRIPE_WEBHOOK_SECRET=whsec_example_local_replace_me
STRIPE_PRICE_ID=price_example_local_monthly
